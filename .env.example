# Copy to .env and fill in. The poller (poller/index.js) reads these.
# On the server these are provided by the systemd unit instead.

# The watch-list spreadsheet ID (from its URL).
SHEET_ID=YOUR_SHEET_ID

# Range read each poll. Rows 2+ are entries.
# Column Y is the optional per-row notifyEveryMinutes override.
SHEET_RANGE=A1:Y50

# Path to the Google service-account JSON key file.
# Share the sheet with this service account's email as Editor.
GOOGLE_KEY_FILE=/opt/movie-monitor/service-account.json

# Telegram bot credentials.
TELEGRAM_BOT_TOKEN=123456:abcdef_your_bot_token
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Poll cadence and display timezone.
POLL_INTERVAL_MINUTES=10
DISPLAY_TIMEZONE=Asia/Kolkata

# Notify on EVERY poll while a movie is open/available, not just on the
# first FALSE->TRUE change. Also ignores notifyCount cap + autoDisable.
# Leave unset/false for change-only alerts.
NOTIFY_EVERY_TIME=false
